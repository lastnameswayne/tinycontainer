# Shared settings for the experiment scripts. Source this file; every value can be
# overridden from the environment.
#
# Two machines in the same AZ (one machine also works: leave STORE_HOST unset):
#   worker box  (where these scripts run)
#     worker      :9444   cwd $EXP_ROOT/worker (runs.db, filecache/), FUSE mount $EXP_ROOT/mnt
#     dind        container "tc-exp-dind", isolated dockerd for the docker baseline
#   store box   ($STORE_HOST, driven over $STORE_SSH)
#     fileserver  :9443 (TLS)   store under $EXP_ROOT/stores/<name>
#     registry    :5000         registry:2 container, baseline images
# Both boxes have this repo at the same path. Separate ports and directories keep the
# stack apart from a production worker/fileserver if one runs on the same host.

# Per-machine settings (STORE_HOST, STORE_SSH, ...) live in exp.local.env next to this file.
_exp_local="$(dirname "${BASH_SOURCE[0]}")/exp.local.env"
# shellcheck disable=SC1090
[ -f "$_exp_local" ] && source "$_exp_local"

REPO=${REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
EXP_ROOT=${EXP_ROOT:-/opt/tc-exp}
BIN=${BIN:-$EXP_ROOT/bin}
RESULTS=${RESULTS:-$REPO/results}

FS_PORT=${FS_PORT:-9443}
WORKER_PORT=${WORKER_PORT:-9444}
REGISTRY_PORT=${REGISTRY_PORT:-5000}

# Store box. STORE_HOST is its private IP as seen from the worker box; STORE_SSH is the
# command prefix that runs a command there (empty = same machine).
STORE_HOST=${STORE_HOST:-localhost}
STORE_SSH=${STORE_SSH:-}

REGISTRY=${REGISTRY:-$STORE_HOST:$REGISTRY_PORT}
DIND=${DIND:-tc-exp-dind}
if [ "$STORE_HOST" = localhost ]; then
  DIND_REGISTRY=${DIND_REGISTRY:-host.docker.internal:$REGISTRY_PORT}  # the registry as seen from inside dind
else
  DIND_REGISTRY=${DIND_REGISTRY:-$STORE_HOST:$REGISTRY_PORT}
fi

FS_DIR=${FS_DIR:-$EXP_ROOT/fileserver}
WORKER_DIR=${WORKER_DIR:-$EXP_ROOT/worker}
MOUNT=${MOUNT:-$EXP_ROOT/mnt}
STORES=${STORES:-$EXP_ROOT/stores}

export FILESERVER_URL=${FILESERVER_URL:-https://$STORE_HOST:$FS_PORT}
export WORKER_URL=${WORKER_URL:-http://localhost:$WORKER_PORT}

# Apps that passed the smoke test (results/apps_ok.txt) unless APPS is set explicitly.
if [ -z "${APPS:-}" ] && [ -s "$RESULTS/apps_ok.txt" ]; then
  APPS=$(tr '\n' ' ' < "$RESULTS/apps_ok.txt")
fi
# Core apps: the ones already known to run on tinycontainer. Extra apps are only used if
# they pass the smoke test.
CORE_APPS=${CORE_APPS:-"testapp2 testapp3 testappscipy testappplotting ml-inference"}
EXTRA_APPS=${EXTRA_APPS:-"hello numpy scipy pandas torch reader"}
APPS=${APPS:-$CORE_APPS}
KEY_APP=${KEY_APP:-testappscipy}   # the app E0, E3 (order stability) and E7 use
REPS=${REPS:-10}
PY=${PY:-$EXP_ROOT/venv/bin/python}
SWAY=${SWAY:-$BIN/sway}

export CORE_APPS EXTRA_APPS KEY_APP REPO EXP_ROOT BIN RESULTS FS_PORT WORKER_PORT REGISTRY_PORT STORE_HOST STORE_SSH REGISTRY DIND DIND_REGISTRY FS_DIR WORKER_DIR MOUNT STORES APPS REPS PY SWAY

log() { echo "[$(date +%H:%M:%S)] $*" >&2; }

# Runs one of these scripts on the store box (or locally in single-box mode).
on_store() {
  local script=$1; shift
  if [ -n "$STORE_SSH" ]; then
    $STORE_SSH sudo "$REPO/scripts/$script" "$@"
  else
    "$REPO/scripts/$script" "$@"
  fi
}
